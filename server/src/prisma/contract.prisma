// use prisma-8

enum Role {
  USER
  LABEL
  ADMIN
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum Genre {
  POP ROCK HIPHOP RNB ELECTRONIC HOUSE TECHNO TRANCE DUBSTEP DRUM_AND_BASS RAP
  JAZZ BLUES CLASSICAL ORCHESTRAL OPERA COUNTRY FOLK FOLK_ROCK INDIE ALTERNATIVE
  METAL HEAVY_METAL PUNK HARDCORE REGGAE SKA SOUL FUNK DISCO LATIN PHONK
  SALSA BOSSA_NOVA SAMBA AFROBEAT K_POP J_POP ANIME SOUNDTRACK AMBIENT CHILLOUT
  LO_FI NEW_AGE GOSPEL SPIRITUAL WORLD CELTIC GUITAR PIANO EXPERIMENTAL SPOKEN_WORD
}

enum AlbumType {
  SINGLE
  EP
  ALBUM
}

enum TrackArtistRole {
  PRIMARY
  FEATURED
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String?
  avatarUrl   String?
  role        Role     @default(USER)

  labelName   String?
  description String?
  website     String?
  verified    Boolean  @default(false)
  createdById Int?
  createdBy   User?    @relation("AdminCreatedLabels", fields: [createdById], references: [id], onDelete: SetNull)
  createdLabels User[] @relation("AdminCreatedLabels")

  playlists   Playlist[]
  history     ListeningHistory[]
  ownedTracks Track[]  @relation("LabelTracks")
  ownedAlbums Album[]  @relation("LabelAlbums")
  createdArtists Artist[] @relation("ArtistCreatedBy")

  reactions   TrackReaction[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Artist {
  id             Int      @id @default(autoincrement())
  name           String
  nameNormalized String   @unique
  bio            String?
  imageUrl       String?
  bannerUrl      String?
  countryCode    String?

  createdById    Int?
  createdBy      User?    @relation("ArtistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  albums       AlbumArtist[]
  tracks       TrackArtist[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([name])
}

model Album {
  id       Int       @id @default(autoincrement())
  title    String
  year     Int?
  coverUrl String?
  type     AlbumType @default(ALBUM)
  isPublished Boolean @default(false)

  labelId  Int
  label    User      @relation("LabelAlbums", fields: [labelId], references: [id], onDelete: Restrict)

  artists  AlbumArtist[]
  tracks   Track[]

  createdAt DateTime @default(now())

  @@index([labelId])
}

model AlbumArtist {
  id       Int              @id @default(autoincrement())
  albumId  Int
  artistId Int
  role     TrackArtistRole  @default(PRIMARY)
  order    Int              @default(0)

  album    Album            @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist   Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([albumId, artistId])
  @@index([albumId])
  @@index([artistId])
}

model Track {
  id        Int      @id @default(autoincrement())
  title     String
  duration  Int
  fileUrl   String
  genre     Genre
  order     Int      @default(0)
  isPublished Boolean @default(false)
  isExplicit  Boolean @default(false)

  playCount    Int      @default(0)
  likeCount    Int      @default(0)
  dislikeCount Int      @default(0)
  reactions    TrackReaction[]

  albumId   Int
  album     Album  @relation(fields: [albumId], references: [id], onDelete: Restrict)

  labelId   Int
  label     User   @relation("LabelTracks", fields: [labelId], references: [id], onDelete: Restrict)

  artists   TrackArtist[]

  playlists PlaylistTrack[]
  history   ListeningHistory[]

  lyrics        String?
  syncedLyrics  String?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([labelId])
  @@index([title])
  @@index([albumId])
}

model TrackArtist {
  id       Int              @id @default(autoincrement())
  trackId  Int
  artistId Int
  role     TrackArtistRole  @default(PRIMARY)
  order    Int              @default(0)

  track    Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist   Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId])
  @@index([artistId])
  @@index([trackId])
}

model Playlist {
  id        Int      @id @default(autoincrement())
  name      String
  isPublic  Boolean  @default(false)
  coverUrl  String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isPublic])
}

model PlaylistTrack {
  id         Int      @id @default(autoincrement())
  playlistId Int
  trackId    Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@unique([playlistId, trackId])
}

model ListeningHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  trackId    Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  listenedAt DateTime @default(now())

  @@index([userId, listenedAt])
}

model TrackReaction {
  id        Int          @id @default(autoincrement())
  userId    Int
  trackId   Int
  type      ReactionType
  order     Int          @default(0)

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)

  createdAt temporal.createdAt()
  updatedAt temporal.updatedAt()

  @@unique([userId, trackId])
  @@index([trackId])
  @@index([userId])
}